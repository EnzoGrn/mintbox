{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Marketplace and collection tracker for toys-to-life collectible figures.\n\nErrors are returned as [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) problem details, with the `application/problem+json` media type.",
    "license" : {
      "name" : "MIT",
      "url" : "https://github.com/EnzoGrn/mintbox/blob/main/LICENSE"
    },
    "title" : "Mintbox API",
    "version" : "0.1.0-SNAPSHOT"
  },
  "externalDocs" : {
    "description" : "Source code, architecture and decision records",
    "url" : "https://github.com/EnzoGrn/mintbox"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the web application"
  } ],
  "tags" : [ {
    "description" : "Every figure that exists, by product line. Read-only.",
    "name" : "Catalog"
  } ],
  "paths" : {
    "/api/catalog/entries" : {
      "get" : {
        "description" : "Lists entries sorted by name, one page at a time. To get the next page, pass the `nextCursor` of the response back as `cursor`, with the same filters. `nextCursor` is null on the last page.",
        "operationId" : "browse",
        "parameters" : [ {
          "description" : "Only entries of this product line",
          "in" : "query",
          "name" : "productLine",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "AMIIBO" ]
          }
        }, {
          "description" : "Only entries of this series, exact name",
          "example" : "Super Smash Bros.",
          "in" : "query",
          "name" : "series",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only entries of this franchise, exact name",
          "example" : "The Legend of Zelda",
          "in" : "query",
          "name" : "franchise",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only entries of this physical form",
          "in" : "query",
          "name" : "figureType",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "FIGURE", "CARD", "YARN", "BAND", "BLOCK" ]
          }
        }, {
          "description" : "Where the previous page ended, as returned in `nextCursor`",
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Maximum number of entries in the page",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 24,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CatalogPage"
                }
              }
            },
            "description" : "One page of entries"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid parameter"
          }
        },
        "summary" : "Browse the catalog",
        "tags" : [ "Catalog" ]
      }
    },
    "/api/catalog/entries/{id}" : {
      "get" : {
        "description" : "Returns one entry, with its release date in each region.",
        "operationId" : "entry",
        "parameters" : [ {
          "description" : "The entry's identifier",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CatalogEntryView"
                }
              }
            },
            "description" : "The entry"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid parameter"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No entry with this identifier"
          }
        },
        "summary" : "Get one entry",
        "tags" : [ "Catalog" ]
      }
    },
    "/api/catalog/search" : {
      "get" : {
        "description" : "Finds entries whose name, character, series or franchise contain every word of `q`, best match first. Typos are tolerated, and case and accents are ignored: `pikachuu` finds Pikachu, `pokemon` finds Pokémon. Words shorter than 3 characters are ignored, so a query made only of them returns no results. Results aren't paginated.",
        "operationId" : "search",
        "parameters" : [ {
          "description" : "The words to look for",
          "example" : "pikachuu",
          "in" : "query",
          "name" : "q",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "description" : "Only entries of this product line",
          "in" : "query",
          "name" : "productLine",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "AMIIBO" ]
          }
        }, {
          "description" : "Only entries of this series, exact name",
          "in" : "query",
          "name" : "series",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only entries of this franchise, exact name",
          "in" : "query",
          "name" : "franchise",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Only entries of this physical form",
          "in" : "query",
          "name" : "figureType",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "FIGURE", "CARD", "YARN", "BAND", "BLOCK" ]
          }
        }, {
          "description" : "Maximum number of results",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 24,
            "maximum" : 100,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CatalogSearchResults"
                }
              }
            },
            "description" : "The best matches first"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid parameter"
          }
        },
        "summary" : "Search the catalog",
        "tags" : [ "Catalog" ]
      }
    },
    "/api/catalog/series" : {
      "get" : {
        "description" : "Returns every series with its number of entries, sorted by name.",
        "operationId" : "series",
        "parameters" : [ {
          "description" : "Only count entries of this product line",
          "in" : "query",
          "name" : "productLine",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "AMIIBO" ]
          }
        }, {
          "description" : "Only count entries of this physical form",
          "in" : "query",
          "name" : "figureType",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "FIGURE", "CARD", "YARN", "BAND", "BLOCK" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SeriesSummary"
                  }
                }
              }
            },
            "description" : "The series"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid parameter"
          }
        },
        "summary" : "List the series",
        "tags" : [ "Catalog" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CatalogEntrySummary" : {
        "type" : "object",
        "properties" : {
          "character" : {
            "type" : "string"
          },
          "figureType" : {
            "type" : "string",
            "enum" : [ "FIGURE", "CARD", "YARN", "BAND", "BLOCK" ]
          },
          "franchise" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "imageUrl" : {
            "type" : "string",
            "format" : "uri"
          },
          "name" : {
            "type" : "string"
          },
          "series" : {
            "type" : "string"
          }
        }
      },
      "CatalogEntryView" : {
        "type" : "object",
        "properties" : {
          "character" : {
            "type" : "string"
          },
          "figureType" : {
            "type" : "string",
            "enum" : [ "FIGURE", "CARD", "YARN", "BAND", "BLOCK" ]
          },
          "franchise" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "imageUrl" : {
            "type" : "string",
            "format" : "uri"
          },
          "name" : {
            "type" : "string"
          },
          "productLine" : {
            "type" : "string",
            "enum" : [ "AMIIBO" ]
          },
          "releaseDates" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string",
              "format" : "date"
            }
          },
          "series" : {
            "type" : "string"
          }
        }
      },
      "CatalogPage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CatalogEntrySummary"
            }
          },
          "nextCursor" : {
            "type" : "string"
          }
        }
      },
      "CatalogSearchResults" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CatalogEntrySummary"
            }
          }
        }
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "SeriesSummary" : {
        "type" : "object",
        "properties" : {
          "entryCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
