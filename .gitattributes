# Normalize line endings to LF in the repository.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated files: collapsed in pull request diffs.
frontend/src/lib/api/schema.d.ts linguist-generated=true

# Binary files: never diff or normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
